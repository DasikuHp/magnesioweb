{% schema %}
{
  "name": "MSI Landing",
  "tag": "div",
  "class": "msi-landing-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Modo de color"
    },
    {
      "type": "select",
      "id": "color_mode",
      "label": "Fondo de la sección",
      "options": [
        { "value": "dark", "label": "Oscuro (negro, actual)" },
        { "value": "light", "label": "Claro (blanco) — piloto verde" }
      ],
      "default": "dark",
      "info": "Modo claro solo tiene animación hero propia para la cápsula verde. El resto de fotos siguen en fondo oscuro."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo de marca",
      "info": "Si se deja vacío se usa el logo del tema (assets/msi-logo.png) en nav, pantalla de carga y footer."
    },
    {
      "type": "header",
      "content": "Colores de acento"
    },
    {
      "type": "color",
      "id": "accent_orange",
      "label": "Naranja (principal)",
      "default": "#e8620a"
    },
    {
      "type": "color",
      "id": "accent_green",
      "label": "Verde",
      "default": "#7bc144"
    },
    {
      "type": "color",
      "id": "accent_gold",
      "label": "Dorado",
      "default": "#c9a84c"
    },
    {
      "type": "color",
      "id": "accent_teal",
      "label": "Turquesa (marca, tema claro)",
      "default": "#00c4cf",
      "info": "Acento principal del modo claro. Para texto pequeño se usa una variante oscura fija."
    },
    {
      "type": "header",
      "content": "Para quién (audiencias)"
    },
    {
      "type": "text",
      "id": "aud_1_title",
      "label": "Bloque 1 — título",
      "default": "Bienestar 50+"
    },
    {
      "type": "textarea",
      "id": "aud_1_desc",
      "label": "Bloque 1 — descripción",
      "default": "A partir de los 50, huesos y energía piden refuerzo. El magnesio contribuye al mantenimiento de los huesos y a reducir el cansancio y la fatiga."
    },
    {
      "type": "image_picker",
      "id": "aud_1_image",
      "label": "Bloque 1 — imagen"
    },
    {
      "type": "text",
      "id": "aud_2_title",
      "label": "Bloque 2 — título",
      "default": "Deportistas"
    },
    {
      "type": "textarea",
      "id": "aud_2_desc",
      "label": "Bloque 2 — descripción",
      "default": "Entrena, rinde, recupera. El magnesio contribuye a la función muscular normal, al equilibrio electrolítico y al metabolismo energético normal."
    },
    {
      "type": "image_picker",
      "id": "aud_2_image",
      "label": "Bloque 2 — imagen"
    },
    {
      "type": "checkbox",
      "id": "show_audience_3",
      "label": "Mostrar bloque 3 (pendiente de aprobación)",
      "default": false,
      "info": "Copy conservador sin claims de enfermedad (Reglamento UE 432/2012). Actívalo cuando dirección confirme el enfoque del tercer público."
    },
    {
      "type": "text",
      "id": "aud_3_title",
      "label": "Bloque 3 — título",
      "default": "Equilibrio mineral"
    },
    {
      "type": "textarea",
      "id": "aud_3_desc",
      "label": "Bloque 3 — descripción",
      "default": "El magnesio contribuye al equilibrio electrolítico y a la función psicológica normal. Si tienes una condición renal, consulta a tu médico antes de tomar cualquier suplemento."
    },
    {
      "type": "image_picker",
      "id": "aud_3_image",
      "label": "Bloque 3 — imagen"
    },
    {
      "type": "header",
      "content": "Hero — frames de animación"
    },
    {
      "type": "text",
      "id": "frames_base_url",
      "label": "URL base de los frames",
