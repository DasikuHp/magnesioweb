      "id": "beat_a_sub",
      "label": "Subtítulo",
      "default": "El mineral que tu cuerpo necesita, en la forma que mejor funciona."
    },
    {
      "type": "header",
      "content": "Hero — Beat B (25–45%)"
    },
    {
      "type": "text",
      "id": "beat_b_tag",
      "label": "Etiqueta",
      "default": "Alta absorción"
    },
    {
      "type": "textarea",
